{
  "name": "@kriterion-cc/participant-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Dependency-free Kriterion participant CLI",
  "license": "Apache-2.0",
  "scripts": {
    "build:native": "node scripts/build-sea.mjs",
    "check": "node --check kriterion && node scripts/check-files.mjs && node scripts/check-docs.mjs && node scripts/check-version.mjs",
    "release:manifest": "node scripts/generate-release.mjs --directory dist",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "postject": "1.0.0-alpha.6"
  }
}

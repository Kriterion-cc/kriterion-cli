#!/usr/bin/env node
'use strict'

const { createHash } = require('node:crypto')

const VERSION = '0.1.0'
const DEFAULT_API = 'https://api.kriterion.cc'
const DEFAULT_TIMEOUT_MS = 30_000
const LOOPBACK_HOSTS = new Set(['localhost', '127.0.0.1', '[::1]'])
const SLUG = /^[a-z0-9][a-z0-9-]{1,63}$/
const REPO = /^https:\/\/[\w.-]+\/[\w./-]+$/
const COMMIT = /^[0-9a-f]{40}$/
const SUBMIT_OPTIONS = new Set(['challenge', 'repo', 'commit', 'model', 'wallet'])

const HELP = `Kriterion participant CLI ${VERSION}

Usage:
  kriterion [--api <url>] [--token <token>] [--json] <command>

Commands:
  whoami
  challenge list
  challenge show <slug>
  board <slug>
  submission show <id>
  submit --challenge <slug> --repo <url> --commit <40-hex-commit>
         [--model <name>] [--wallet <address>]

Environment:
  KRITERION_API                 API base URL. Default: https://api.kriterion.cc
  KRITERION_TOKEN               Token from the Kriterion Settings page
  KRITERION_TIMEOUT_MS          Request timeout. Default: 30000
  CF_ACCESS_CLIENT_ID           Optional Cloudflare Access service-token ID
  CF_ACCESS_CLIENT_SECRET       Optional Cloudflare Access service-token secret

The CLI writes JSON to standard output. Node.js 18 or newer is required.
Run Lean checks locally with lake build before submission.`

class CliError extends Error {
  constructor(message, exitCode = 1, payload = null) {
    super(message)
    this.exitCode = exitCode
    this.payload = payload
  }
}

function parseGlobal(argv) {
  const options = {
    api: process.env.KRITERION_API || DEFAULT_API,
    token: process.env.KRITERION_TOKEN,
    timeoutMs: parseTimeout(process.env.KRITERION_TIMEOUT_MS),
  }
  const rest = []
  for (let index = 0; index < argv.length; index += 1) {
    const value = argv[index]
    if (value === '--api' || value === '--token') {
      const next = argv[index + 1]
      if (!next || next.startsWith('--')) throw new CliError(`${value} needs a value`)
      options[value.slice(2)] = next
      index += 1
    } else if (value !== '--json') {
      rest.push(value)
    }
  }
  validateApi(options.api)
  validateAccessEnvironment()
  return { options, rest }
}

function parseTimeout(raw) {
  if (raw === undefined || raw === '') return DEFAULT_TIMEOUT_MS
  const value = Number(raw)
  if (!Number.isInteger(value) || value < 1 || value > 300_000) {
    throw new CliError('KRITERION_TIMEOUT_MS must be an integer from 1 to 300000')
  }
  return value
}

function validateApi(raw) {
  let url
  try { url = new URL(raw) } catch { throw new CliError('--api must be a valid URL') }
  if (url.protocol !== 'https:' && !(url.protocol === 'http:' && LOOPBACK_HOSTS.has(url.hostname))) {
    throw new CliError('--api must use https, except for local loopback testing')
  }
}

function validateAccessEnvironment() {
  const hasId = Boolean(process.env.CF_ACCESS_CLIENT_ID)
  const hasSecret = Boolean(process.env.CF_ACCESS_CLIENT_SECRET)
  if (hasId !== hasSecret) {
    throw new CliError('set both Cloudflare Access service-token variables, or set neither')
  }
}

function parseNamed(argv, allowed) {
  const options = {}
  for (let index = 0; index < argv.length; index += 1) {
    const name = argv[index]
    const value = argv[index + 1]
    if (!name?.startsWith('--') || !value || value.startsWith('--')) {
      throw new CliError(`invalid option near "${name || ''}"`)
    }
    const key = name.slice(2)
    if (!allowed.has(key)) throw new CliError(`unknown option "${name}"`)
    if (Object.hasOwn(options, key)) throw new CliError(`option "${name}" was given more than once`)
    options[key] = value
    index += 1
  }
  return options
}

function need(value, name) {
  if (!value) throw new CliError(`${name} is required`)
  return value
}

function valid(value, pattern, name) {
  if (!pattern.test(value)) throw new CliError(`${name} is invalid`)
  return value
}

function endpoint(base, pathname) {
  const normalized = base.endsWith('/') ? base : `${base}/`
  return new URL(pathname.replace(/^\//, ''), normalized)
}

function exitCode(status, payload) {
  const supplied = payload?.error?.exitCode
  if (Number.isInteger(supplied) && supplied >= 1 && supplied <= 4) return supplied
  if (status === 401 || status === 403) return 4
  if (status === 409 || status === 425) return 3
  if (status === 422) return 2
  return 1
}

function responsePayload(response, text) {
  if (!(response.headers.get('content-type') || '').includes('json') || !text) return text
  try { return JSON.parse(text) } catch { return text }
}

async function request(options, method, pathname, body, needsToken = false) {
  if (needsToken && !options.token) {
    throw new CliError('KRITERION_TOKEN is required', 4)
  }
  const headers = { accept: 'application/json' }
  if (options.token) headers.authorization = `Bearer ${options.token}`
  if (process.env.CF_ACCESS_CLIENT_ID) {
    headers['CF-Access-Client-Id'] = process.env.CF_ACCESS_CLIENT_ID
    headers['CF-Access-Client-Secret'] = process.env.CF_ACCESS_CLIENT_SECRET
  }
  if (body !== undefined) headers['content-type'] = 'application/json'

  let response
  try {
    response = await fetch(endpoint(options.api, pathname), {
      method,
      headers,
      body: body === undefined ? undefined : JSON.stringify(body),
      redirect: 'manual',
      signal: AbortSignal.timeout(options.timeoutMs),
    })
  } catch (error) {
    const detail = error.name === 'TimeoutError' ? `request timed out after ${options.timeoutMs} ms` : error.message
    throw new CliError(`cannot reach ${options.api}: ${detail}`)
  }

  if (response.status >= 300 && response.status < 400) {
    throw new CliError('API redirects are refused to protect authentication credentials')
  }

  const text = await response.text()
  const payload = responsePayload(response, text)
  if (!response.ok) {
    let message = payload?.error?.message || `${method} ${pathname} failed with ${response.status}`
    if (response.status === 403 && typeof payload === 'string' && /cloudflare/i.test(payload)) {
      message += '. Configure the Cloudflare Access service-token variables if this API requires them'
    }
    throw new CliError(message, exitCode(response.status, payload), payload)
  }
  return payload
}

async function main(argv) {
  if (argv.includes('--help') || argv.includes('-h')) {
    console.log(HELP)
    return 0
  }
  if (argv.includes('--version') || argv.includes('-V')) {
    console.log(VERSION)
    return 0
  }

  const { options, rest } = parseGlobal(argv)
  if (rest.length === 0) {
    console.log(HELP)
    return 0
  }

  const command = rest[0]
  let result
  if (command === 'whoami' && rest.length === 1) {
    result = await request(options, 'GET', '/auth/me', undefined, true)
  } else if (command === 'challenge' && rest[1] === 'list' && rest.length === 2) {
    result = await request(options, 'GET', '/challenges')
  } else if (command === 'challenge' && rest[1] === 'show' && rest.length === 3) {
    const slug = valid(rest[2], SLUG, 'challenge slug')
    result = await request(options, 'GET', `/challenges/${encodeURIComponent(slug)}`)
  } else if (command === 'board' && rest.length === 2) {
    const slug = valid(rest[1], SLUG, 'challenge slug')
    result = await request(options, 'GET', `/boards/${encodeURIComponent(slug)}`)
  } else if (command === 'submission' && rest[1] === 'show' && rest.length === 3) {
    result = await request(options, 'GET', `/submissions/${encodeURIComponent(rest[2])}`)
  } else if (command === 'submit') {
    const named = parseNamed(rest.slice(1), SUBMIT_OPTIONS)
    const challenge = valid(need(named.challenge, '--challenge'), SLUG, 'challenge slug')
    const repo = valid(need(named.repo, '--repo'), REPO, 'repository URL')
    const commit = valid(need(named.commit, '--commit'), COMMIT, 'commit')
    const body = {
      repo,
      commit,
      idempotencyKey: createHash('sha256')
        .update(repo)
        .update('\0')
        .update(commit)
        .digest('hex')
        .slice(0, 32),
      ...(named.model ? { modelAttribution: named.model } : {}),
      ...(named.wallet ? { walletAddress: named.wallet } : {}),
    }
    result = await request(
      options,
      'POST',
      `/challenges/${encodeURIComponent(challenge)}/submissions`,
      body,
      true,
    )
  } else {
    throw new CliError(`unknown command\n\n${HELP}`)
  }

  console.log(typeof result === 'string' ? result : JSON.stringify(result, null, 2))
  return 0
}

main(process.argv.slice(2)).then(
  (code) => { process.exitCode = code },
  (error) => {
    const payload = error instanceof CliError ? error.payload : null
    console.error(payload ? JSON.stringify(payload, null, 2) : `error: ${error.message}`)
    process.exitCode = error instanceof CliError ? error.exitCode : 1
  },
)
